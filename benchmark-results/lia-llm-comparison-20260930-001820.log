def somar_pares(valores: list[int]) -> int:
    return sum(num for num in valores if num % 2 == 0)

# Asserts de teste
assert somar_pares([]) == 0, "A lista vazia deve retornar 0"
assert somar_pares([1, 2, 3, 4, 5]) == 6, "Valores mistos: apenas 2 e 4 são pares"
assert somar_pares([-2, -3, -4, -5]) == -6, "Números negativos: -2 e -4 são pares"
