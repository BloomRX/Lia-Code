def somar_pares(valores: list[int]) -> int:
    assert isinstance(valores, list), "O argumento deve ser uma lista"
    assert todos os elementos de valores são inteiros, "Todos os elementos devem ser inteiros"
    assert todos os elementos de valores são pares, "Todos os elementos devem ser pares"
    
    return sum(x for x in valores se x % 2 == 0)

# Testes de Casos de Abordagem
# Casos de Abordagem 1: Lista Vazia
somar_pares([])  # Deve passar sem erros

# Casos de Abordagem 2: Valores Mistos (Inteiros Pares e Ímpares)
somar_pares([1, 2, 3, 4, 5, 6])  # Deve passar sem erros

